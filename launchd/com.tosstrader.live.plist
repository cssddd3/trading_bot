<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.tosstrader.live</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/caffeinate</string>
        <string>-i</string>
        <string>/opt/homebrew/bin/python3</string>
        <string>-u</string>
        <string>/Users/YOUR_USERNAME/toss-trader/run_dryrun.py</string>
        <string>--watch</string>
        <string>--live</string>
    </array>
    <key>WorkingDirectory</key><string>/Users/YOUR_USERNAME/toss-trader</string>
    <key>KeepAlive</key><true/>
    <key>ThrottleInterval</key><integer>30</integer>
    <key>StandardOutPath</key><string>/Users/YOUR_USERNAME/toss-trader/logs/watch.log</string>
    <key>StandardErrorPath</key><string>/Users/YOUR_USERNAME/toss-trader/logs/watch.log</string>
</dict>
</plist>
