# 토스증권 WTS > 설정 > Open API 에서 발급받은 값을 넣으세요.
# 이 파일을 .env 로 복사한 뒤 채우세요. (.env는 절대 깃헙에 올리지 마세요!)
TOSS_CLIENT_ID=여기에_client_id
TOSS_CLIENT_SECRET=여기에_client_secret

# (선택) LLM 뉴스 필터 — https://platform.claude.com 에서 발급
# 없으면 뉴스 필터가 자동으로 꺼지고 규칙 기반으로만 동작합니다.
ANTHROPIC_API_KEY=
# NEWS_LLM_MODEL=claude-opus-5

# (선택) 텔레그램 알림 — notify.py 상단 주석 참고
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# (선택) 실전 봇 예산 — 계좌에 돈을 더 넣었으면 여기 숫자를 올리고 봇 재시작
LIVE_BUDGET_KR=50000
LIVE_BUDGET_US=50000

# DART 전자공시 모니터 (선택): https://opendart.fss.or.kr 무료 발급 후 붙여넣기.
# 있으면 감시/보유 종목의 새 공시를 기사보다 빨리 텔레그램으로 알려준다.
DART_API_KEY=

# LLM 역할별 모델 오버라이드 (선택 — 기본: 스카우트 sonnet-5, 필터/비서 haiku-4-5)
# SCOUT_LLM_MODEL=claude-sonnet-5
# NEWS_LLM_MODEL=claude-haiku-4-5
# ASSISTANT_LLM_MODEL=claude-haiku-4-5

# 공유 채널 (선택): 스카우트 픽·매수/매도·공시를 텔레그램 채널로도 발신 (지인 구독용).
# 채널 생성 → 봇을 관리자로 추가 → 공개채널이면 @채널이름, 비공개면 숫자 chat_id.
# 계좌 수치(예수금/예산/수량)는 채널에 안 나간다. 명령 수신은 여전히 개인 챗만.
TELEGRAM_BROADCAST_CHAT_ID=
